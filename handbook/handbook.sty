% Calculus registry
% --------------------------------------------------------------------------
\newif\ifhb@sheetlabels
\hb@sheetlabelstrue

\newcommand\calculussheet[3]{%
  \par\addvspace{\bigskipamount}%
  \refstepcounter{hbsheet}%
  \noindent{\bfseries Calculus sheet: #2}%
  \ifhb@sheetlabels\label{#1}\fi
  \par\nobreak
  {\small\itshape #3\par}%
  \nobreak\addvspace{\smallskipamount}}

% the explicit empty-side-condition token; never typeset directly
\newcommand\none{%
  \PackageError{handbook}{\string\none\space typeset outside \string\hbrule}%
    {\string\none\space is only meaningful as the fifth (side-condition)
     argument of \string\hbrule\space (CONVENTIONS.md, 'Calculus registry').}}
\def\hb@nonetoken{\none}

\def\hb@checkrulearg#1#2#3{% <arg>{<argname>}{<rule label arg>}
  \def\hb@ruleargtest{#1}%
  \ifx\hb@ruleargtest\hb@empty
    \PackageError{handbook}{\string\hbrule\space '\detokenize{#3}': empty
      #2 argument}%
      {All five \string\hbrule\space arguments are mandatory; an empty side
       condition must be the explicit token \string\none\space
       (CONVENTIONS.md, 'Calculus registry').}%
  \fi}

% \hbrule{rule:<id>}{<Name>}{<premises>}{<conclusion>}{<side conditions>}
%   premises and conclusion are typeset in (display-style) math mode; empty
%   premises render as an axiom line; #5 = \none suppresses the side line.
\newcommand\hbrule[5]{%
  \hb@checkrulearg{#1}{label}{#1}%
  \hb@checkrulearg{#2}{name}{#1}%
  \hb@checkrulearg{#4}{conclusion}{#1}%
  \def\hb@sidetest{#5}%
  \ifx\hb@sidetest\hb@empty
    \PackageError{handbook}{\string\hbrule\space '\detokenize{#1}': empty
      side-condition argument}%
      {An empty side condition must be the explicit token \string\none\space
       (CONVENTIONS.md, 'Calculus registry').}%
  \fi
  \par\addvspace{\smallskipamount}%
  \refstepcounter{hbrule}%
  \ifhb@sheetlabels\label{#1}\fi
  \noindent\hfil
  $\dfrac{\;#3\;}{\;#4\;}$\;{\small(#2)}%
  \hfil\par
  \ifx\hb@sidetest\hb@nonetoken\else
    \nobreak\noindent\hfil
    {\footnotesize side condition: #5}%
    \hfil\par
  \fi
  \addvspace{\smallskipamount}}

% \showcalculus{<slug>}: input registry/calculi/<slug>.tex; repeat inclusions
% render but suppress \label so labels stay unique (hyperref anchors remain
% unique because the sheet/rule counters are global and always stepped).
\newcommand\showcalculus[1]{%
  \IfFileExists{registry/calculi/#1.tex}{%
    \ifcsname hb@sheet@seen@#1\endcsname
      \begingroup\hb@sheetlabelsfalse\input{registry/calculi/#1.tex}\endgroup
    \else
      \global\@namedef{hb@sheet@seen@#1}{}%
      \input{registry/calculi/#1.tex}%
    \fi
  }{%
    \PackageError{handbook}{no calculus sheet registry/calculi/#1.tex}%
      {Calculi live one per file under registry/calculi/
       (CONVENTIONS.md, 'Calculus registry').}}}

