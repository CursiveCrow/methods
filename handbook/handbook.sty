\newenvironment{annexitem}[3]{%
  \par\addvspace{\bigskipamount}%
  \hb@inannextrue
  \refstepcounter{annexitem}%
  \hb@extractannexid{#1}%
  \noindent{\bfseries Annex
    \expandafter\MakeUppercase\expandafter{\hb@curannexid}\ (#3).}%
  \label{#1}%
  \par\nobreak
  \noindent{\small[proves \hyperref[#2]{\texttt{#2}}]}%
  \par\nobreak\addvspace{\smallskipamount}\ignorespaces
}{\par\addvspace{\bigskipamount}}

% Editorial proofs live only inside annexitem (CONVENTIONS.md, 'Status
% grammar').  A mechanically validated, source-exact inherited fragment may
% retain its original proof only while the restoration scope above is active.
% amsthm's proof is a \newenvironment with an optional argument, so \proof is
% an opt-arg dispatcher that calls the INTERNAL macro (csname \string\proof)
% by name; save the internal, or the wrapper recurses through the dispatcher.
\expandafter\let\expandafter\hb@proofinternal\csname\string\proof\endcsname
\let\hb@endproof\endproof
\renewenvironment{proof}[1][\proofname]{%
  \ifhb@inannex\else
    \ifhb@inheritedrestoration\else
      \PackageError{handbook}{proof environment outside the annex or an
        inherited restoration scope}%
        {Editorial body files contain NO proof environments; proofs live only
         under annex/ inside annexitem.  Source-exact inherited proofs require
         a provenance-gated wrapper validated by tools/check.py.}%
    \fi
  \fi
  \hb@proofinternal[{#1}]%
  % A leading paragraph heading must not overwrite amsthm's pending item label.
  \ifhb@inannex\leavevmode\fi\ignorespaces}{\hb@endproof}

% a sketch must open with \sketchnote{<what is omitted>}
\newcommand\sketchnote[1]{%
  \par\noindent{\bfseries Sketch.}\enspace
  {\small\itshape Omissions: #1}\par
  \nobreak\addvspace{\smallskipamount}}

% Annex TOC number-width switch.
% Necessity: book.cls reserves only 1.5em for chapter numbers and 1.55em for
%   page numbers, which lets fixed annex identifiers P2--P12 touch ``Proof
%   Annex'' and lets long annex titles touch three-digit folios; an explicit
%   end delimiter is required so later TOC entries inherit neither wider box.
% Definition: \hbannextocsetup changes the annex chapter-number and page-number
%   boxes to 2.5em for the subsequent proof-annex entries read from the .toc
%   file; \hbannextocrestore changes them back to 1.5em and 1.55em;
%   \hbannexfinish writes exactly one protected restore command to the .toc
%   file and does nothing else.
% Standing: all three names are layout/build-control syntax, not chapters,
%   annex identities, source names, or publication-status assertions;
%   \hbannexfinish does not restore chapter counters or numbering.
% Nonredundancy: the left chapter-number box and right page-number box protect
%   different boundaries; setup performs their TOC-execution-time widening,
%   restore performs its TOC-execution-time reversal, and finish serializes
%   that reversal at document time after the final annex.  Ordinary body
%   chapter entries retain the book-class widths, and the section-width repair
%   above cannot affect chapter entries.
% Use: \hbannexsetup writes the switch immediately before the proof-annex part
%   and chapter entries, including the widest fixed identifier P12; main.tex
%   calls \hbannexfinish immediately after annex/p12 so the restoration is read
%   before the later bibliography entry.
\newcommand\hbannextocsetup{%
  \patchcmd{\l@chapter}%
    {\setlength\@tempdima{1.5em}}%
    {\setlength\@tempdima{2.5em}}%
    {}%
    {\PackageError{handbook}{cannot widen proof-annex TOC chapter numbers}%
       {The book-class chapter-entry definition changed; update the exact
        annex-only TOC patch rather than accepting fused number/title text.}}%
  \ifdefstring{\@pnumwidth}{1.55em}%
    {\def\@pnumwidth{2.5em}}%
    {\PackageError{handbook}{cannot widen proof-annex TOC page numbers}%
       {The book-class page-number width changed; update the exact annex-only
        TOC switch rather than accepting fused title/page text.}}}
\newcommand\hbannextocrestore{%
  \patchcmd{\l@chapter}%
    {\setlength\@tempdima{2.5em}}%
    {\setlength\@tempdima{1.5em}}%
    {}%
    {\PackageError{handbook}{cannot restore the ordinary TOC chapter width}%
       {The annex-only TOC switch was not active or changed unexpectedly.}}%
  \ifdefstring{\@pnumwidth}{2.5em}%
    {\def\@pnumwidth{1.55em}}%
    {\PackageError{handbook}{cannot restore the ordinary TOC page-number width}%
       {The annex-only TOC switch was not active or changed unexpectedly.}}}

% Annex chapter identities stay P1..P19; heading ordinals follow body layout.
\newcommand\hbannexsetup{%
  \addtocontents{toc}{\protect\hbannextocsetup}%
  \renewcommand\thechapter{P\arabic{chapter}}%
  \renewcommand\theHchapter{annex.\arabic{chapter}}%
  \setcounter{chapter}{0}}
\newcommand\hbannexfinish{%
  \addtocontents{toc}{\protect\hbannextocrestore}}
\newcommand\hbannexchapter[2]{% {<stable part number>}{<legacy title>}
  \edef\hb@annexpartid{p\two@digits{#1}}%
  \hb@setstablepart{\hb@annexpartid}%
  \setcounter{chapter}{\numexpr#1-1\relax}%
  % Keep the two-argument driver interface; the approved map owns the title.
  \edef\hb@annexheading{Proof Annex for Part
    \hbpartdisplayordinal{\hb@annexpartid}: \hbparttitle{\hb@annexpartid}}%
  \expandafter\chapter\expandafter{\hb@annexheading}%
  \edef\hb@annexmark{Proof Annex for Part
    \hbpartdisplayordinal{\hb@annexpartid}}%
  \expandafter\chaptermark\expandafter{\hb@annexmark}}

