% --------------------------------------------------------------------------
% Status-spec parser (compile-mandatory grammar)
%   \hbparsestatus{<spec>} defines \hb@statusform, \hb@statustarget and, for
%   the annex forms, \hb@annexid; empty/malformed input -> \PackageError.
% --------------------------------------------------------------------------
\let\hb@NIL\relax
\def\hb@NILholder{\hb@NIL}
\def\hb@empty{}
\def\hb@formproved{proved}
\def\hb@formsketched{sketched}
\def\hb@formcited{cited}

\def\hb@statuserror#1#2{%
  \PackageError{handbook}%
    {Malformed status spec '\detokenize{#1}'\MessageBreak(#2)}%
    {Status specs are single tokens of exactly one of three forms:\MessageBreak
     \space\space proved=annex:<id>\MessageBreak
     \space\space sketched=annex:<id>\MessageBreak
     \space\space cited=<bibkey>\MessageBreak
     See handbook/CONVENTIONS.md, section 'Status grammar'.}}

% recovery values so a nonstop run can limp on after the error
\def\hb@statusrecover{%
  \def\hb@statusform{cited}%
  \def\hb@statustarget{hb-malformed}%
  \def\hb@annexid{}}

\def\hbparsestatus#1{%
  \def\hb@rawspec{#1}%
  \ifx\hb@rawspec\hb@empty
    \hb@statuserror{<empty>}{the mandatory status argument is empty}%
    \hb@statusrecover
  \else
    \hb@parse@a#1=\hb@NIL\hb@stop{#1}%
  \fi}

% split at the first '='
\def\hb@parse@a#1=#2\hb@stop#3{%
  \def\hb@statusform{#1}%
  \def\hb@resttest{#2}%
  \ifx\hb@resttest\hb@NILholder
    \hb@statuserror{#3}{missing '=' separator}%
    \hb@statusrecover
  \else
    \hb@parse@b#2\hb@stop{#3}%
  \fi}

% #2 of \hb@parse@a always ends with =\hb@NIL here; strip it, reject extra '='
\def\hb@parse@b#1=#2\hb@stop#3{%
  \def\hb@statustarget{#1}%
  \def\hb@excess{#2}%
  \ifx\hb@excess\hb@NILholder
    \hb@validate{#3}%
  \else
    \hb@statuserror{#3}{more than one '='}%
    \hb@statusrecover
  \fi}

\def\hb@validate#1{%
  \ifx\hb@statusform\hb@empty
    \hb@statuserror{#1}{empty form before the '='}%
    \hb@statusrecover
  \else
    \ifx\hb@statustarget\hb@empty
      \hb@statuserror{#1}{empty target after the '='}%
      \hb@statusrecover
    \else
      \hb@validateform{#1}%
    \fi
  \fi}

\def\hb@validateform#1{%
  \ifx\hb@statusform\hb@formproved
    \hb@checkannextarget{#1}%
  \else
    \ifx\hb@statusform\hb@formsketched
      \hb@checkannextarget{#1}%
    \else
      \ifx\hb@statusform\hb@formcited
        \relax% bibkey target; nonemptiness already enforced
      \else
        \hb@statuserror{#1}{unknown form; allowed: proved, sketched, cited}%
        \hb@statusrecover
      \fi
    \fi
  \fi}

% proved=/sketched= targets must be annex:<id> with nonempty <id>
\def\hb@checkannextarget#1{%
  \expandafter\hb@checkannex@a\hb@statustarget annex:\hb@stop{#1}}
\def\hb@checkannex@a#1annex:#2\hb@stop#3{%
  \def\hb@pretest{#1}%
  \ifx\hb@pretest\hb@empty
    \hb@stripannextail#2\hb@stop
    \ifx\hb@annexid\hb@empty
      \hb@statuserror{#3}{empty annex id after 'annex:'}%
      \hb@statusrecover
    \fi
  \else
    \hb@statuserror{#3}{proved=/sketched= target must be annex:<id>}%
    \hb@statusrecover
  \fi}
\def\hb@stripannextail#1annex:\hb@stop{\def\hb@annexid{#1}}

% --------------------------------------------------------------------------
% Status tagline: "Status: proved (Annex P5.3)" / "Status: cited ([Jec03])"
% --------------------------------------------------------------------------
\def\hb@taglinetext{%
  Status: \hb@statusform\space
  \ifx\hb@statusform\hb@formcited
    (\expandafter\cite\expandafter{\hb@statustarget})%
  \else
    (\hyperref[\hb@statustarget]{Annex
      \expandafter\MakeUppercase\expandafter{\hb@annexid}})%
  \fi}

% --------------------------------------------------------------------------
% Title splitter with makeindex sort-key support
%   \hb@splittitle{<title>} -> \hb@titleindex (verbatim tokens, for \index)
%                              \hbTitleDisp   (display text, sort key removed)
% Delimiter catcodes: the @ in document text is catcode 12, so the split
% macros are defined in a catcode-12 group (hence the @-free public names).
% --------------------------------------------------------------------------
\begingroup
\catcode`\@=12
\long\gdef\hbTitleSplitA#1@#2\hbTitleStop{\gdef\hbTitleA{#1}\gdef\hbTitleB{#2}}
\long\gdef\hbTitleSplitB#1@\hbTitleStop{\gdef\hbTitleDisp{#1}}
\gdef\hbTitleSentinel{@}
\endgroup

\long\def\hb@splittitle#1{%
  \long\gdef\hb@titleindex{#1}%
  \expandafter\hb@splittitle@aux\expandafter{\hbTitleSentinel}{#1}}
\long\def\hb@splittitle@aux#1#2{% #1 = catcode-12 @ sentinel, #2 = title
  \hbTitleSplitA#2#1\hbTitleStop
  \ifx\hbTitleB\hb@empty
    \global\let\hbTitleDisp\hbTitleA
  \else
    \expandafter\hbTitleSplitB\hbTitleB\hbTitleStop
  \fi}

