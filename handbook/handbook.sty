\newcommand\hbstub[1]{%
  \par\addvspace{\medskipamount}\noindent
  \fbox{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{%
    {\bfseries STUB.}\enspace #1}}\par
  \addvspace{\medskipamount}}

