%% handbook.sty --- LaTeX infrastructure for the formal-logic handbook (Phase 3)
%%
%% Implements handbook/CONVENTIONS.md exactly.  ALL environments and macros of
%% the handbook tree are defined here, nowhere else.
%%
%% Public interface (see CONVENTIONS.md for the binding grammar):
%%   \begin{hbtheorem}{thm:<id>}{<status-spec>}{<Title>} ... \end{hbtheorem}
%%   \begin{hblemma}{thm:<id>}{<status-spec>}{<Title>} ... \end{hblemma}
%%   \begin{hbcorollary}{thm:<id>}{<status-spec>}{<Title>} ... \end{hbcorollary}
%%   \begin{hbdefinition}{def:<id>}{<Title>} ...            (indexed)
%%   \begin{hbconvention}{def:<id>}{<Title>} ...
%%   \begin{hbmethod}{def:<id>}{<Title>} ...
%%   \begin{hbexample}{def:<id>}{<Title>} ...
%%   \begin{hbwarning}{def:<id>}{<Title>} ...               (indexed)
%%   \begin{proofboundary}{def:<id>}{<Title>} ...           (indexed)
%%   \begin{systementry}{entry:<id>}{<System Name>} + \entry... fields
%%   \begin{annexitem}{annex:<id>}{thm:<backref>}{<Title>} ...
%%   \begin{inheritedrestorationscope}{<provenance-id>} ...
%%   \hbstub{...}  \sketchnote{...}
%%   \calculussheet{sheet:<slug>}{<Name>}{<identity>}
%%   \hbrule{rule:<id>}{<Name>}{<premises>}{<conclusion>}{<side cond | \none>}
%%   \showcalculus{<slug>}
%%
%% Status specs are single tokens of EXACTLY one of the three forms
%%     proved=annex:<id>   sketched=annex:<id>   cited=<bibkey>
%% and are compile-mandatory: an empty or malformed spec raises \PackageError.
%% Each status is rendered as a tagline ("Status: proved (Annex P5.3)", with a
%% hyperlink) and harvested to \jobname.hbstatus as
%%     <label>|<status-form>|<target>|<part>
%% Complete entry-card metadata is harvested to \jobname.hbentry as typed
%% records (payload columns are last, so literal `|' characters remain safe):
%%     CARD|<entry-label>|<part>|<system-name>
%%     FIELD|<entry-label>|<field>|<content>
%%     STATUS|<entry-label>|<field>|<status-form>|<target>|<content>
%%
%% Index hooks: hbdefinition/hbtheorem/hbwarning/proofboundary titles are
%% written to the index.  Sort keys use the makeindex convention INSIDE the
%% title argument: {Godel numbering@G\"odel numbering} indexes under the sort
%% key and displays the part after the @.  A title without @ is used verbatim.
%% (Brace the @ ({\char64}) if a literal @ must appear in a displayed title.)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{handbook}[2026/08/11 v0.4 formal-logic handbook infrastructure (Phase 4 cards)]

