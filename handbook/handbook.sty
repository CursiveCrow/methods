% Stable part ownership and edition layout (EDITION-2026-CONTRACT.md)
% Drivers declare their stable ID before their one public \part heading.
% Ownership never comes from the printed counter.  Record its next ordinal
% separately so annex headings follow the actual construction order during
% migration; standalone annex checks fall back to the approved edition order.
% Stable annex chapter numbers and hyperlink identities remain P1, ..., P19.
% --------------------------------------------------------------------------
\def\hb@declarepart#1#2#3{%
  \expandafter\def\csname hb@partordinal@#1\endcsname{#2}%
  \expandafter\def\csname hb@parttitle@#1\endcsname{#3}}
\hb@declarepart{p01}{1}{Foundations of Formal Work}
\hb@declarepart{p02}{2}{Classical Logic}
\hb@declarepart{p03}{3}{Model Theory}
\hb@declarepart{p04}{4}{Computability and Complexity}
\hb@declarepart{p05}{5}{Arithmetic and Incompleteness}
\hb@declarepart{p06}{6}{Axiomatic Set Theory}
\hb@declarepart{p07}{7}{Proof Theory, Lambda Calculi, and Higher-Order Logic}
\hb@declarepart{p08}{8}{Nonclassical Logics}
\hb@declarepart{p09}{9}{Logic in Computer Science}
\hb@declarepart{p10}{10}{Algebraic and Categorical Logic}
\hb@declarepart{p15}{11}{Uncertainty and Statistical Inference}
\hb@declarepart{p16}{12}{Explanation, Abduction and Causation}
\hb@declarepart{p17}{13}{Decision and Strategic Reasoning}
\hb@declarepart{p18}{14}{Argumentation and Informal Reasoning}
\hb@declarepart{p19}{15}{Empirical Science of Reasoning}
\hb@declarepart{p11}{16}{Philosophy of Logic}
\hb@declarepart{p12}{17}{Automation, Mechanization, and Formal Practice}
\hb@declarepart{p13}{18}{Chronology and Biography}
\hb@declarepart{p14}{19}{Apparatus}
\newcommand\hbcurrentpartid{}
\def\hb@partidentityerror#1{%
  \PackageError{handbook}{invalid or missing stable part ID '#1'}%
    {Declare \string\hbpartidentity{p01} through {p19} at the owning
     part-driver boundary; printed part counters are not ownership IDs.}}
\def\hb@setstablepart#1{%
  \ifcsname hb@partordinal@#1\endcsname
    \xdef\hbcurrentpartid{#1}%
  \else
    \hb@partidentityerror{#1}%
  \fi}
\newcommand\hbpartidentity[1]{%
  \hb@setstablepart{#1}%
  \ifcsname hb@partordinal@#1\endcsname
    \expandafter\xdef\csname hb@observedpartordinal@#1\endcsname{%
      \number\numexpr\c@part+1\relax}%
  \fi}
\def\hb@requirepartidentity{%
  \ifcsname hb@partordinal@\hbcurrentpartid\endcsname\else
    \hb@partidentityerror{\hbcurrentpartid}%
  \fi}
\newcommand\hbpartordinal[1]{%
  \ifcsname hb@partordinal@#1\endcsname
    \csname hb@partordinal@#1\endcsname
  \else
    \hb@partidentityerror{#1}%
  \fi}
\newcommand\hbparttitle[1]{%
  \ifcsname hb@parttitle@#1\endcsname
    \csname hb@parttitle@#1\endcsname
  \else
    \hb@partidentityerror{#1}%
  \fi}
\def\hb@partdisplaynumber#1{%
  \ifcsname hb@observedpartordinal@#1\endcsname
    \csname hb@observedpartordinal@#1\endcsname
  \else
    \hbpartordinal{#1}%
  \fi}
\newcommand\hbpartdisplayordinal[1]{%
  \@Roman{\hb@partdisplaynumber{#1}}}

% \hb@beginresult{<Name>}{<label>}{<status>}{<title>}{<bodyfont>}{<index 0/1>}
\long\def\hb@beginresult#1#2#3#4#5#6{%
  \par\addvspace{\medskipamount}%
  \hbparsestatus{#3}%
  \refstepcounter{hbitem}%
  \hb@splittitle{#4}%
  \noindent{\bfseries #1~\thehbitem\ (\hbTitleDisp).}%
  \label{#2}%
  \ifnum#6=1\relax
    \expandafter\index\expandafter{\hb@titleindex}%
  \fi
  \hb@requirepartidentity
  \immediate\write\hb@statusout{#2|\hb@statusform|\hb@statustarget|\hbcurrentpartid}%
  \enspace#5\ignorespaces}
\def\hb@endresult{%
  \par\nobreak
  {\noindent\small\itshape\hb@taglinetext\par}%
  \addvspace{\medskipamount}}

% \hb@beginplain{<Name>}{<label>}{<title>}{<bodyfont>}{<index 0/1>}
\long\def\hb@beginplain#1#2#3#4#5{%
  \par\addvspace{\medskipamount}%
  \refstepcounter{hbitem}%
  \hb@splittitle{#3}%
  \noindent{\bfseries #1~\thehbitem\ (\hbTitleDisp).}%
  \label{#2}%
  \ifnum#5=1\relax
    \expandafter\index\expandafter{\hb@titleindex}%
  \fi
  \enspace#4\ignorespaces}
\def\hb@endplain{\par\addvspace{\medskipamount}}

% Each editorial environment shares hbitem for numbering but records its own
% reference kind.  The local alias is set before refstepcounter and ends with
% the environment group; it changes neither source counters nor proof status.
\newenvironment{hbtheorem}[3]{\crefalias{hbitem}{theorem}\hb@beginresult{Theorem}{#1}{#2}{#3}{\itshape}{1}}{\hb@endresult}
\newenvironment{hblemma}[3]{\crefalias{hbitem}{lemma}\hb@beginresult{Lemma}{#1}{#2}{#3}{\itshape}{0}}{\hb@endresult}
\newenvironment{hbcorollary}[3]{\crefalias{hbitem}{corollary}\hb@beginresult{Corollary}{#1}{#2}{#3}{\itshape}{0}}{\hb@endresult}
\newenvironment{hbdefinition}[2]{\crefalias{hbitem}{definition}\hb@beginplain{Definition}{#1}{#2}{\upshape}{1}}{\hb@endplain}
\newenvironment{hbconvention}[2]{\crefalias{hbitem}{convention}\hb@beginplain{Convention}{#1}{#2}{\upshape}{0}}{\hb@endplain}
\newenvironment{hbmethod}[2]{\crefalias{hbitem}{method}\hb@beginplain{Method}{#1}{#2}{\upshape}{0}}{\hb@endplain}
\newenvironment{hbexample}[2]{\crefalias{hbitem}{example}\hb@beginplain{Example}{#1}{#2}{\upshape}{0}}{\hb@endplain}
\newenvironment{hbwarning}[2]{\crefalias{hbitem}{warning}\hb@beginplain{Warning}{#1}{#2}{\upshape}{1}}{\hb@endplain}
\newenvironment{proofboundary}[2]{\crefalias{hbitem}{proofboundary}\hb@beginplain{Proof boundary}{#1}{#2}{\upshape}{1}}{\hb@endplain}

% Exact inherited artifacts retain the source environment names.  This is the
% source's existing definition environment, not a new handbook concept or an
% editorial substitute.  It is available only so unchanged source tokens can
% compile inside a provenance-validated restoration wrapper.
\newenvironment{definition}[1][]{%
