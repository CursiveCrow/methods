% Necessity: exact source lines 14315--14326 contain literal pseudocode whose
% whitespace and line breaks cannot be represented by an existing prose or
% mathematical environment without changing the source tokens.
% Definition: logiccode is exactly the frozen source's listings style: small
% monospaced full-flexible columns, preserved spaces, a single pale-gray frame,
% line breaking, and hidden string-space markers.
% Standing: it is a source-rendering abbreviation, not a logical calculus,
% algorithm definition, source-fidelity verdict, build, visual, or admission.
% Nonredundancy: ordinary verbatim lacks the source caption/frame/breaking
% surface, while editorial code environments are not authorized source tokens.
% Use: the restored DPLL listing at source lines 14315--14326 uses this exact
% style; the static source-environment scan rejects lstlisting elsewhere.
\providecolor{LogicGray}{HTML}{F2F4F7}
\providecolor{LogicBlue}{HTML}{17365D}
\providecolor{LogicRed}{HTML}{7A1F1F}
\lstdefinestyle{logiccode}{
  basicstyle=\ttfamily\small,
  columns=fullflexible,
  keepspaces=true,
  frame=single,
  rulecolor=\color{black!25},
  backgroundcolor=\color{LogicGray},
  breaklines=true,
  showstringspaces=false
}
\lstset{style=logiccode}

% Necessity: book.cls computes the index column widths before its later 35pt
% assignment, so the inherited 10pt value lets a long left entry enter the
% right column.  Definition: immediately before theindex begins, establish the
% book class's intended 35pt \columnsep before that width computation.
% Standing: this is a
% presentation-only use of the existing LaTeX length, not a source term or an
% audit, admission, build, visual, register, or acceptance result.
% Nonredundancy: ordinary one-column text and the book's later index formatting
% do not recompute this width.  Use: the printed two-column index requires at
% least 4pt between opposing entries while retaining its existing text tokens.
\BeforeBeginEnvironment{theindex}{\setlength{\columnsep}{35pt}}

% Necessity: the book-class section TOC row has two independent failures: its
% 2.3em number box lets 12.10 touch a title, and its 1.55em page box lets a long
% title touch a three-digit folio.
% Definition: each section row locally uses a 3em number box and widens only an
% ordinary 1.55em page-number reserve to 2.3em before running the unchanged
% book-class dotted-line algorithm.
% Standing: this is presentation-only TOC syntax, not a source term, section
% identity, audit, admission, build, visual, or publication-status assertion.
% Nonredundancy: the chapter-entry patch protects only chapter title/folio
% spacing, and the annex switch protects annex chapter entries; neither fixes
% both edges of an ordinary body section row.
% Use: multi-digit section numbers and the exact long Section 64.4 TOC title
% must each retain at least one readable gap without moving chapter or
% subsection entries.
\renewcommand*\l@section[2]{%
  \begingroup
  \ifdefstring{\@pnumwidth}{1.55em}{\def\@pnumwidth{2.3em}}{}%
  \@dottedtocline{1}{1.5em}{3em}{#1}{#2}%
  \endgroup}

% Necessity: the book-class chapter TOC entry reserves only 1.55em at its
% right edge, so the exact Chapter 25 title touches its three-digit folio.
% Definition: inside each chapter entry's existing local group, replace the
% ordinary 1.55em reserve by 2.3em before the book-class line-breaking code
% runs; preserve the annex switch's separately established 2.5em reserve.
% Standing: this is presentation-only TOC syntax, not a source term, chapter
% identity, audit result, admission result, or publication-status assertion.
% Nonredundancy: the section number-width repair protects the opposite edge of
% section rows, while the annex switch protects P2--P12 number/title spacing;
% neither reserves the ordinary body chapter title/folio boundary.
% Use: the Chapter 25 TOC row must render its exact long title separately from
% folio 245 while short body rows and every right-aligned folio stay in place.
\patchcmd{\l@chapter}%
  {\begingroup}%
  {\begingroup\ifdefstring{\@pnumwidth}{1.55em}%
     {\def\@pnumwidth{2.3em}}{}}%
  {}%
  {\PackageError{handbook}{cannot widen body TOC page-number reserve}%
     {The book-class chapter-entry definition changed; update the exact
      chapter TOC patch rather than accepting fused title/page text.}}%

% Necessity: the book-class running heads allow either a long even-page chapter
% mark or a long odd-page section mark to touch its folio.
% Definition: the two running-head controls preserve the original mark and
% folio positions when they fit; otherwise they reserve exactly 1em at the
% inner boundary and scale only the exceptional mark to the remaining width.
% Standing: the controls and their shared boxes/dimension are presentation-only
% TeX syntax, not source terms, result families, audits, admissions, or reviews.
% Nonredundancy: the even control protects folio/leftmark, while the odd control
% protects rightmark/folio; neither orientation can establish the other's gap.
% Use: ps@headings installs both controls so every printed running head retains
% a readable boundary without changing short-header book-class coordinates.
\newsavebox\hb@runningheadfolio
\newsavebox\hb@runningheadmark
\newdimen\hb@runningheadmarkwidth
\newcommand\hb@evenrunninghead{%
  \sbox\hb@runningheadfolio{\thepage}%
  \sbox\hb@runningheadmark{\slshape\leftmark}%
  \hb@runningheadmarkwidth=\textwidth
  \advance\hb@runningheadmarkwidth by -\wd\hb@runningheadfolio
  \advance\hb@runningheadmarkwidth by -1em
  \usebox\hb@runningheadfolio
  \ifdim\wd\hb@runningheadmark>\hb@runningheadmarkwidth
    \hspace{1em}%
    \resizebox{\hb@runningheadmarkwidth}{!}{\usebox\hb@runningheadmark}%
  \else
    \hfil\usebox\hb@runningheadmark
  \fi}
\newcommand\hb@oddrunninghead{%
  \sbox\hb@runningheadfolio{\thepage}%
  \sbox\hb@runningheadmark{\slshape\rightmark}%
  \hb@runningheadmarkwidth=\textwidth
  \advance\hb@runningheadmarkwidth by -\wd\hb@runningheadfolio
  \advance\hb@runningheadmarkwidth by -1em
  \ifdim\wd\hb@runningheadmark>\hb@runningheadmarkwidth
    \resizebox{\hb@runningheadmarkwidth}{!}{\usebox\hb@runningheadmark}%
    \hspace{1em}%
  \else
    \usebox\hb@runningheadmark\hfil
  \fi
  \usebox\hb@runningheadfolio}
\let\hb@bookheadings\ps@headings
\renewcommand\ps@headings{%
  \hb@bookheadings
  \def\@evenhead{\hb@evenrunninghead}%
  \def\@oddhead{\hb@oddrunninghead}}
\pagestyle{headings}

