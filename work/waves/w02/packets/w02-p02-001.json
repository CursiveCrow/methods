      "unit_id": "ED26-P02-syllogistic-0001",
      "title": "An explicit categorical-syllogistic calculus, with empty-term boundaries",
      "required_components": [
        {
          "id": "LR001-C1",
          "description": "Define the S and S-dagger languages and their set semantics.",
          "success_condition": "Give exact formula formation, complement roles and domain assumptions before the rule table.",
          "failure_condition": "Treat subject negation or arbitrary Boolean structure as licensed in the smaller S fragment.",
          "open": true
        },
        {
          "id": "LR001-C2",
          "description": "Present both rule systems and prove their soundness and completeness.",
          "success_condition": "Supply all cases used by the source's Section 3 proof, including inconsistent premises and the reduction from S-dagger to S.",
          "failure_condition": "Import a first-order proof while leaving the promised direct syllogistic calculus unproved.",
          "open": true
        },
        {
          "id": "LR001-C3",
          "description": "Provide a validity and existential-import lookup with countermodels.",
          "success_condition": "Give a worked derivation and a model with an empty predicate extension blocking illicit existential import.",
          "failure_condition": "Infer Some A are B from All A are B without an existence premise.",
          "open": true
        },
        {
          "id": "LR001-C4",
          "description": "Separate the modern formal reconstruction from Aristotle's historical system.",
          "success_condition": "Link ED26-SRC-063-0102 and ED26-SRC-063-0103 and identify differing assumptions.",
          "failure_condition": "Attribute S/S-dagger unchanged to Aristotle or duplicate a whole SRC-063 history chapter.",
          "open": true
        }
