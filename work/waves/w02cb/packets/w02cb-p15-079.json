      "title": "Dimensional and scaling constraints on quantitative claims",
      "required_components": [
        {
          "id": "ED26-GAP-SCI-002-C01",
          "description": "Construct dimensionless products as a linear nullspace problem.",
          "success_condition": "Solve a dimension matrix and explain the rank-dependent count of independent products.",
          "failure_condition": "Subtract the number of written dimension names without checking rank.",
          "open": true
        },
        {
          "id": "ED26-GAP-SCI-002-C02",
          "description": "Use proportional reasoning to separate exponents from constants.",
          "success_condition": "Derive an admissible exponent relation and identify what remains empirically undetermined.",
          "failure_condition": "Present dimensional consistency as proof of the physical law.",
          "open": true
        },
        {
          "id": "ED26-GAP-SCI-002-C03",
          "description": "Check units, conversions and scaling regimes.",
          "success_condition": "Detect a dimensionally invalid expression and state the fixed quantities in a scaling comparison.",
          "failure_condition": "Change units or variables silently, or extrapolate a regime-specific scaling law.",
          "open": true
        },
        {
          "id": "ED26-GAP-SCI-002-C04",
          "description": "Work an estimate with explicit bounds on what it supports.",
          "success_condition": "Give one order-of-magnitude estimate with input ranges and an omitted-variable failure.",
          "failure_condition": "Report unearned digits or treat the estimate as a confidence interval.",
          "open": true
        }
      ],
