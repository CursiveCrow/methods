{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewed-presentation-packet-admissions.schema.json",
  "title": "Independent presentation-packet content-admission records",
  "description": "Schema validity is necessary but not sufficient. The generator also checks the live packet, packet verification, exact projections, maintained destination, labels, and six separate evidence artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_root", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "packet_root": {"const": "spec/presentations"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_fidelity_ai",
        "topic_specialist_ai",
        "adversarial_publication_ai",
        "static",
        "build",
        "visual"
      ],
      "properties": {
        "source_fidelity_ai": {"const": "pass"},
        "topic_specialist_ai": {"const": "pass"},
        "adversarial_publication_ai": {"const": "pass"},
        "static": {"const": "pass"},
        "build": {"const": "pass"},
        "visual": {"const": "pass"}
      }
    },
    "authorityFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "aiEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "recorded_result",
        "artifact_path",
        "sha256",
        "producer_identity",
        "recorded_scope",
        "model",
        "model_version",
        "instructions",
        "consulted_authority_files",
        "consulted_authority_locators",
        "findings",
        "evidence_digest"
      ],
      "properties": {
        "category": {
          "enum": [
            "source_fidelity_ai",
            "topic_specialist_ai",
            "adversarial_publication_ai"
          ]
        },
        "recorded_result": {"const": "pass"},
        "artifact_path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "producer_identity": {"$ref": "#/$defs/nonemptyString"},
        "recorded_scope": {"$ref": "#/$defs/nonemptyString"},
        "model": {"$ref": "#/$defs/nonemptyString"},
        "model_version": {"$ref": "#/$defs/nonemptyString"},
        "instructions": {"$ref": "#/$defs/nonemptyString"},
        "consulted_authority_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/authorityFile"}
        },
        "consulted_authority_locators": {"$ref": "#/$defs/stringSet"},
        "findings": {"$ref": "#/$defs/stringSet"},
        "evidence_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "mechanicalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "recorded_result",
        "artifact_path",
        "sha256",
        "producer_identity",
        "recorded_scope"
      ],
      "properties": {
        "category": {"enum": ["static", "build", "visual"]},
        "recorded_result": {"const": "pass"},
        "artifact_path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "producer_identity": {"$ref": "#/$defs/nonemptyString"},
        "recorded_scope": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "evidence": {
      "oneOf": [
        {"$ref": "#/$defs/aiEvidence"},
        {"$ref": "#/$defs/mechanicalEvidence"}
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_path",
        "packet_sha256",
        "admission_status",
        "authority_projection_sha256",
        "presentation_identity_projection_sha256",
        "content_projection_sha256",
        "present_content_item_ids",
        "destination_file",
        "destination_sha256",
        "destination_labels",
        "verification",
        "verification_evidence"
      ],
      "properties": {
        "packet_id": {"$ref": "#/$defs/nonemptyString"},
        "packet_path": {"$ref": "#/$defs/repositoryPath"},
        "packet_sha256": {"$ref": "#/$defs/sha256"},
        "admission_status": {"const": "admitted"},
        "authority_projection_sha256": {"$ref": "#/$defs/sha256"},
        "presentation_identity_projection_sha256": {"$ref": "#/$defs/sha256"},
        "content_projection_sha256": {"$ref": "#/$defs/sha256"},
        "present_content_item_ids": {"$ref": "#/$defs/stringSet"},
        "destination_file": {
          "allOf": [
            {"$ref": "#/$defs/repositoryPath"},
            {"pattern": "^handbook/"}
          ]
        },
        "destination_sha256": {"$ref": "#/$defs/sha256"},
        "destination_labels": {"$ref": "#/$defs/stringSet"},
        "verification": {"$ref": "#/$defs/verification"},
        "verification_evidence": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/evidence"},
          "allOf": [
            {"contains": {"properties": {"category": {"const": "source_fidelity_ai"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"category": {"const": "topic_specialist_ai"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"category": {"const": "adversarial_publication_ai"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"category": {"const": "static"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"category": {"const": "build"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"category": {"const": "visual"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1}
          ]
        }
      }
    }
  }
}
