{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewed-handbook-unit-records.schema.json",
  "title": "Input checked before parsed handbook-unit defaults are changed",
  "description": "Schema validity is necessary but not sufficient. The generator checks the exact pinned unit identity, live source/packet/register links, evidence hashes, canonical array order, and distinct evidence artifacts and producer strings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "construction_snapshot_sha256",
    "handbook_unit_inventory_sha256",
    "records"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "construction_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "handbook_unit_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "stableLabels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_fidelity_ai",
        "topic_specialist_ai",
        "adversarial_publication_ai",
        "static",
        "build",
        "visual"
      ],
      "properties": {
        "source_fidelity_ai": {"const": "pass"},
        "topic_specialist_ai": {"const": "pass"},
        "adversarial_publication_ai": {"const": "pass"},
        "static": {"const": "pass"},
        "build": {"const": "pass"},
        "visual": {"const": "pass"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "recorded_result",
        "artifact_path",
        "sha256",
        "producer_identity",
        "recorded_scope"
      ],
      "properties": {
        "category": {
          "enum": [
            "source_fidelity_ai",
            "topic_specialist_ai",
            "adversarial_publication_ai",
            "static",
            "build",
            "visual"
          ]
        },
        "recorded_result": {"const": "pass"},
        "artifact_path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "producer_identity": {"$ref": "#/$defs/nonemptyString"},
        "recorded_scope": {"$ref": "#/$defs/nonemptyString"},
        "model": {"$ref": "#/$defs/nonemptyString"},
        "model_version": {"$ref": "#/$defs/nonemptyString"},
        "instructions": {"$ref": "#/$defs/nonemptyString"},
        "consulted_authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/consultedAuthority"}
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonemptyString"}
        },
        "other_review_outputs_consulted": {"const": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "enum": [
                  "source_fidelity_ai",
                  "topic_specialist_ai",
                  "adversarial_publication_ai"
                ]
              }
            },
            "required": ["category"]
          },
          "then": {
            "required": [
              "model",
              "model_version",
              "instructions",
              "consulted_authorities",
              "findings",
              "other_review_outputs_consulted"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["model"]},
                {"required": ["model_version"]},
                {"required": ["instructions"]},
                {"required": ["consulted_authorities"]},
                {"required": ["findings"]},
                {"required": ["other_review_outputs_consulted"]}
              ]
            }
          }
        }
      ]
    },
    "consultedAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "locator", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "locator": {"$ref": "#/$defs/nonemptyString"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "record_type",
        "path",
        "start_line",
        "end_line",
        "bytes",
        "sha256",
        "unit_kind",
        "named_owner_key",
        "named_title",
        "stable_labels",
        "line_standing",
        "parser_basis",
        "parser_status",
        "mapping_status",
        "semantic_review_status",
        "source_authority_ids",
        "presentation_packet_ids",
        "register_obligation_ids",
        "verification",
        "verification_evidence"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^HBU-[0-9a-f]{24}$"
        },
        "record_type": {
          "enum": ["physical_interval", "binary_file", "empty_text_file"]
        },
        "path": {"$ref": "#/$defs/repositoryPath"},
        "start_line": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "end_line": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "unit_kind": {"type": "string"},
        "named_owner_key": {"type": "string"},
        "named_title": {"type": "string"},
        "stable_labels": {"$ref": "#/$defs/stableLabels"},
        "line_standing": {
          "enum": [
            "reader-facing candidate",
            "nonprinting control candidate",
            "comment",
            "blank material",
            "binary artifact",
            "empty text artifact"
          ]
        },
        "parser_basis": {"$ref": "#/$defs/nonemptyString"},
        "parser_status": {"const": "parsed/unchecked"},
        "mapping_status": {"const": "mapped/reviewed"},
        "semantic_review_status": {"enum": ["pass", "not-applicable"]},
        "source_authority_ids": {"$ref": "#/$defs/stringArray"},
        "presentation_packet_ids": {"$ref": "#/$defs/stringArray"},
        "register_obligation_ids": {"$ref": "#/$defs/stringArray"},
        "verification": {"$ref": "#/$defs/verification"},
        "verification_evidence": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    }
  }
}
