{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formal-logic-handbook.invalid/schema/presentation-packet.schema.json",
  "title": "Formal Logic Compendium Presentation Packet",
  "description": "Administrative record for exactly one separately attributed source presentation. This schema does not define or select logical content, and validation cannot establish semantic truth, source fidelity, completeness, or reviewer independence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "overall_status",
    "authority",
    "presentation_identity",
    "reconstruction_mode",
    "content",
    "technical_names",
    "variants",
    "obligation_links",
    "destination",
    "completeness",
    "verification",
    "verification_evidence",
    "owed_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "packet_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "overall_status": {
      "enum": ["open", "verified"]
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "presentation_identity": {
      "$ref": "#/$defs/presentationIdentity"
    },
    "reconstruction_mode": {
      "enum": ["full_transcription", "full_reconstruction", "open_missing"]
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "technical_names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/technicalName"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variantReference"
      }
    },
    "obligation_links": {
      "$ref": "#/$defs/obligationLinks"
    },
    "destination": {
      "$ref": "#/$defs/destination"
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "verification_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verificationEvidence"
      }
    },
    "owed_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/owedArtifact"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "verified"
          }
        },
        "required": ["overall_status"]
      },
      "then": {
        "properties": {
          "reconstruction_mode": {
            "enum": ["full_transcription", "full_reconstruction"]
          },
          "authority": {
            "required": ["local_path", "source_sha256"]
          },
          "presentation_identity": {
            "properties": {
              "identity_status": {"const": "identified"}
            }
          },
          "owed_artifacts": {
            "maxItems": 0
          },
          "content": {
            "properties": {
              "notation_roles": {"minItems": 1},
              "conventions": {"minItems": 1},
              "syntax": {"minItems": 1},
              "definitions": {"minItems": 1},
              "axioms": {"minItems": 1},
              "calculi": {"minItems": 1},
              "rules": {"minItems": 1},
              "side_conditions": {"minItems": 1},
              "semantic_clauses": {"minItems": 1},
              "statements": {"minItems": 1},
              "hypotheses": {"minItems": 1},
              "results": {"minItems": 1},
              "proofs": {"minItems": 1},
              "proof_boundaries": {"minItems": 1},
              "examples": {"minItems": 1},
              "counterexamples": {"minItems": 1},
              "exercises": {"minItems": 1},
              "exercise_solutions": {"minItems": 1},
              "exercise_feedback": {"minItems": 1},
              "warnings": {"minItems": 1},
              "qualifications": {"minItems": 1},
              "tables": {"minItems": 1},
              "source_attributions": {"minItems": 1}
            },
            "anyOf": [
              {"properties": {"notation_roles": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"conventions": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"syntax": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"definitions": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"axioms": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"calculi": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"rules": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"side_conditions": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"semantic_clauses": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"statements": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"hypotheses": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"results": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"proofs": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"proof_boundaries": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"examples": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"counterexamples": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"exercises": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"exercise_solutions": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"exercise_feedback": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"warnings": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"qualifications": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}},
              {"properties": {"tables": {"contains": {"properties": {"status": {"const": "present"}}, "required": ["status"]}}}}
            ]
          },
          "obligation_links": {
            "properties": {
              "coverage_assignments": {
                "items": {
                  "properties": {
                    "assignment_status": {"const": "fulfilled"}
                  }
                }
              },
              "register_assignments": {
                "items": {
                  "properties": {
                    "assignment_status": {"const": "fulfilled"}
                  }
                }
              }
            }
          },
          "completeness": {
            "properties": {
              "notation": {"const": "pass"},
              "conventions": {"const": "pass"},
              "syntax": {"const": "pass"},
              "definitions": {"const": "pass"},
              "axioms": {"const": "pass"},
              "calculi": {"const": "pass"},
              "rules": {"const": "pass"},
              "side_conditions": {"const": "pass"},
              "semantic_clauses": {"const": "pass"},
              "hypotheses": {"const": "pass"},
              "statements": {"const": "pass"},
              "results": {"const": "pass"},
              "proofs": {"const": "pass"},
              "proof_boundaries": {"const": "pass"},
              "examples": {"const": "pass"},
              "counterexamples": {"const": "pass"},
              "exercises": {"const": "pass"},
              "exercise_solutions": {"const": "pass"},
              "exercise_feedback": {"const": "pass"},
              "warnings": {"const": "pass"},
              "qualifications": {"const": "pass"},
              "tables": {"const": "pass"},
              "attribution": {"const": "pass"}
            }
          },
          "verification": {
            "properties": {
              "source_fidelity_ai": {"const": "pass"},
              "topic_specialist_ai": {"const": "pass"},
              "adversarial_publication_ai": {"const": "pass"},
              "static": {"const": "pass"},
              "build": {"const": "pass"},
              "visual": {"const": "pass"}
            }
          },
          "verification_evidence": {
            "minItems": 6,
            "maxItems": 6,
            "allOf": [
              {"contains": {"properties": {"kind": {"const": "source_fidelity_ai"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "topic_specialist_ai"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "adversarial_publication_ai"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "static"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "build"}}, "required": ["kind"]}},
              {"contains": {"properties": {"kind": {"const": "visual"}}, "required": ["kind"]}}
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "open"
          }
        },
        "required": ["overall_status"]
      },
      "then": {
        "properties": {
          "owed_artifacts": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work", "edition", "exact_locator"],
      "properties": {
        "work": {"$ref": "#/$defs/nonemptyString"},
        "edition": {"$ref": "#/$defs/nonemptyString"},
        "exact_locator": {"$ref": "#/$defs/nonemptyString"},
        "url": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "local_path": {"$ref": "#/$defs/nonemptyString"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      },
      "anyOf": [
        {"required": ["url"]},
        {"required": ["local_path"]}
      ]
    },
    "presentationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_status", "house_selected", "synthesized", "hybrid"],
      "properties": {
        "identity_status": {"enum": ["unresolved", "identified"]},
        "source_given_name": {"$ref": "#/$defs/nonemptyString"},
        "exact_eliminable_description": {"$ref": "#/$defs/nonemptyString"},
        "house_selected": {"const": false},
        "synthesized": {"const": false},
        "hybrid": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"identity_status": {"const": "identified"}}, "required": ["identity_status"]},
          "then": {
            "anyOf": [
              {"required": ["source_given_name"]},
              {"required": ["exact_eliminable_description"]}
            ]
          }
        },
        {
          "if": {"properties": {"identity_status": {"const": "unresolved"}}, "required": ["identity_status"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["source_given_name"]},
                {"required": ["exact_eliminable_description"]}
              ]
            }
          }
        }
      ]
    },
    "presentContentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "status", "source_locator", "content_digest"],
      "properties": {
        "item_id": {"$ref": "#/$defs/nonemptyString"},
        "status": {"const": "present"},
        "source_locator": {"$ref": "#/$defs/nonemptyString"},
        "text": {"$ref": "#/$defs/nonemptyString"},
        "artifact_path": {"$ref": "#/$defs/nonemptyString"},
        "content_digest": {"$ref": "#/$defs/sha256"},
        "attribution_note": {"$ref": "#/$defs/nonemptyString"}
      },
      "oneOf": [
        {"required": ["text"]},
        {"required": ["artifact_path"]}
      ]
    },
    "notApplicableContentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "status",
        "source_locator",
        "source_justification"
      ],
      "properties": {
        "item_id": {"$ref": "#/$defs/nonemptyString"},
        "status": {"const": "not_applicable"},
        "source_locator": {"$ref": "#/$defs/nonemptyString"},
        "source_justification": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "contentItem": {
      "oneOf": [
        {"$ref": "#/$defs/presentContentItem"},
        {"$ref": "#/$defs/notApplicableContentItem"}
      ]
    },
    "contentArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/contentItem"}
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notation_roles",
        "conventions",
        "syntax",
        "definitions",
        "axioms",
        "calculi",
        "rules",
        "side_conditions",
        "semantic_clauses",
        "statements",
        "hypotheses",
        "results",
        "proofs",
        "proof_boundaries",
        "examples",
        "counterexamples",
        "exercises",
        "exercise_solutions",
        "exercise_feedback",
        "warnings",
        "qualifications",
        "tables",
        "source_attributions"
      ],
      "properties": {
        "notation_roles": {"$ref": "#/$defs/contentArray"},
        "conventions": {"$ref": "#/$defs/contentArray"},
        "syntax": {"$ref": "#/$defs/contentArray"},
        "definitions": {"$ref": "#/$defs/contentArray"},
        "axioms": {"$ref": "#/$defs/contentArray"},
        "calculi": {"$ref": "#/$defs/contentArray"},
        "rules": {"$ref": "#/$defs/contentArray"},
        "side_conditions": {"$ref": "#/$defs/contentArray"},
        "semantic_clauses": {"$ref": "#/$defs/contentArray"},
        "statements": {"$ref": "#/$defs/contentArray"},
        "hypotheses": {"$ref": "#/$defs/contentArray"},
        "results": {"$ref": "#/$defs/contentArray"},
        "proofs": {"$ref": "#/$defs/contentArray"},
        "proof_boundaries": {"$ref": "#/$defs/contentArray"},
        "examples": {"$ref": "#/$defs/contentArray"},
        "counterexamples": {"$ref": "#/$defs/contentArray"},
        "exercises": {"$ref": "#/$defs/contentArray"},
        "exercise_solutions": {"$ref": "#/$defs/contentArray"},
        "exercise_feedback": {"$ref": "#/$defs/contentArray"},
        "warnings": {"$ref": "#/$defs/contentArray"},
        "qualifications": {"$ref": "#/$defs/contentArray"},
        "tables": {"$ref": "#/$defs/contentArray"},
        "source_attributions": {"$ref": "#/$defs/contentArray"}
      }
    },
    "technicalName": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "necessity",
        "definition_or_axiom",
        "standing",
        "nonredundancy",
        "use"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/nonemptyString"},
        "necessity": {"$ref": "#/$defs/nonemptyString"},
        "definition_or_axiom": {"$ref": "#/$defs/nonemptyString"},
        "standing": {"$ref": "#/$defs/nonemptyString"},
        "nonredundancy": {"$ref": "#/$defs/nonemptyString"},
        "use": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "variantReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["related_packet_id", "source_locator", "source_stated_relation"],
      "properties": {
        "related_packet_id": {"$ref": "#/$defs/nonemptyString"},
        "source_locator": {"$ref": "#/$defs/nonemptyString"},
        "source_stated_relation": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "obligationLinks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_assignments", "register_assignments"],
      "properties": {
        "coverage_assignments": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/obligationAssignment"}
        },
        "register_assignments": {
          "type": "array",
          "items": {"$ref": "#/$defs/obligationAssignment"}
        }
      }
    },
    "obligationAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "assignment_status",
        "source_locator",
        "present_content_item_ids",
        "owed_artifact_ids"
      ],
      "properties": {
        "obligation_id": {"$ref": "#/$defs/nonemptyString"},
        "assignment_status": {"enum": ["open", "fulfilled"]},
        "source_locator": {"$ref": "#/$defs/nonemptyString"},
        "present_content_item_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonemptyString"}
        },
        "owed_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonemptyString"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"assignment_status": {"const": "fulfilled"}},
            "required": ["assignment_status"]
          },
          "then": {
            "properties": {
              "present_content_item_ids": {"minItems": 1},
              "owed_artifact_ids": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"assignment_status": {"const": "open"}},
            "required": ["assignment_status"]
          },
          "then": {
            "properties": {
              "present_content_item_ids": {"maxItems": 0},
              "owed_artifact_ids": {"minItems": 1}
            }
          }
        }
      ]
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "stable_labels"],
      "properties": {
        "file": {"$ref": "#/$defs/nonemptyString"},
        "stable_labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonemptyString"}
        }
      }
    },
    "dimensionResult": {
      "enum": ["pending", "pass", "fail"]
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notation",
        "conventions",
        "syntax",
        "definitions",
        "axioms",
        "calculi",
        "rules",
        "side_conditions",
        "semantic_clauses",
        "hypotheses",
        "statements",
        "results",
        "proofs",
        "proof_boundaries",
        "examples",
        "counterexamples",
        "exercises",
        "exercise_solutions",
        "exercise_feedback",
        "warnings",
        "qualifications",
        "tables",
        "attribution"
      ],
      "properties": {
        "notation": {"$ref": "#/$defs/dimensionResult"},
        "conventions": {"$ref": "#/$defs/dimensionResult"},
        "syntax": {"$ref": "#/$defs/dimensionResult"},
        "definitions": {"$ref": "#/$defs/dimensionResult"},
        "axioms": {"$ref": "#/$defs/dimensionResult"},
        "calculi": {"$ref": "#/$defs/dimensionResult"},
        "rules": {"$ref": "#/$defs/dimensionResult"},
        "side_conditions": {"$ref": "#/$defs/dimensionResult"},
        "semantic_clauses": {"$ref": "#/$defs/dimensionResult"},
        "hypotheses": {"$ref": "#/$defs/dimensionResult"},
        "statements": {"$ref": "#/$defs/dimensionResult"},
        "results": {"$ref": "#/$defs/dimensionResult"},
        "proofs": {"$ref": "#/$defs/dimensionResult"},
        "proof_boundaries": {"$ref": "#/$defs/dimensionResult"},
        "examples": {"$ref": "#/$defs/dimensionResult"},
        "counterexamples": {"$ref": "#/$defs/dimensionResult"},
        "exercises": {"$ref": "#/$defs/dimensionResult"},
        "exercise_solutions": {"$ref": "#/$defs/dimensionResult"},
        "exercise_feedback": {"$ref": "#/$defs/dimensionResult"},
        "warnings": {"$ref": "#/$defs/dimensionResult"},
        "qualifications": {"$ref": "#/$defs/dimensionResult"},
        "tables": {"$ref": "#/$defs/dimensionResult"},
        "attribution": {"$ref": "#/$defs/dimensionResult"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_fidelity_ai", "topic_specialist_ai", "adversarial_publication_ai", "static", "build", "visual"],
      "properties": {
        "source_fidelity_ai": {"$ref": "#/$defs/dimensionResult"},
        "topic_specialist_ai": {"$ref": "#/$defs/dimensionResult"},
        "adversarial_publication_ai": {"$ref": "#/$defs/dimensionResult"},
        "static": {"$ref": "#/$defs/dimensionResult"},
        "build": {"$ref": "#/$defs/dimensionResult"},
        "visual": {"$ref": "#/$defs/dimensionResult"}
      }
    },
    "verificationEvidence": {
      "oneOf": [
        {"$ref": "#/$defs/aiVerificationEvidence"},
        {"$ref": "#/$defs/mechanicalVerificationEvidence"}
      ]
    },
    "authorityFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/nonemptyString"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "aiVerificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact_path", "sha256", "verifier_identity", "verification_scope", "independently_produced", "model", "model_version", "instructions", "consulted_authority_files", "consulted_authority_locators", "findings", "evidence_digest"],
      "properties": {
        "kind": {"enum": ["source_fidelity_ai", "topic_specialist_ai", "adversarial_publication_ai"]},
        "artifact_path": {"$ref": "#/$defs/nonemptyString"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "verifier_identity": {"$ref": "#/$defs/nonemptyString"},
        "verification_scope": {"$ref": "#/$defs/nonemptyString"},
        "independently_produced": {"const": true},
        "model": {"$ref": "#/$defs/nonemptyString"},
        "model_version": {"$ref": "#/$defs/nonemptyString"},
        "instructions": {"$ref": "#/$defs/nonemptyString"},
        "consulted_authority_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/authorityFile"}},
        "consulted_authority_locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonemptyString"}},
        "findings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonemptyString"}},
        "evidence_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "mechanicalVerificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact_path", "sha256", "verifier_identity", "verification_scope", "independently_produced"],
      "properties": {
        "kind": {"enum": ["static", "build", "visual"]},
        "artifact_path": {"$ref": "#/$defs/nonemptyString"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "verifier_identity": {"$ref": "#/$defs/nonemptyString"},
        "verification_scope": {"$ref": "#/$defs/nonemptyString"},
        "independently_produced": {"const": true}
      }
    },
    "owedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_kind", "description", "source_obligation", "completion_condition"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/nonemptyString"},
        "artifact_kind": {"enum": ["presentation_identity", "authority", "content", "destination", "variant_relation", "verification", "other"]},
        "description": {"$ref": "#/$defs/nonemptyString"},
        "source_obligation": {"$ref": "#/$defs/nonemptyString"},
        "completion_condition": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
